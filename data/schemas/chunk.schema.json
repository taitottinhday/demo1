{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "K71 retrieval chunk v1",
  "type": "object",
  "required": ["chunk_id", "record_id", "parent_id", "text", "retrieval_text", "source_id", "source_version", "topics", "scope", "historical", "answer_eligible", "context_required", "evidence"],
  "properties": {
    "chunk_id": {"type": "string", "minLength": 1},
    "record_id": {"type": "string", "minLength": 1},
    "parent_id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "retrieval_text": {"type": "string", "minLength": 1},
    "source_version": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "historical": {"type": "boolean"},
    "answer_eligible": {"type": "boolean"},
    "context_required": {"type": "boolean"},
    "cohort": {"const": "K71"},
    "extraction_method": {"enum": ["native", "ocr"]}
  }
}
