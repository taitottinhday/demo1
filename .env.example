# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
# Legacy template only; MVP database is configured by MVP_DATA_DIR below.
DATABASE_URL=sqlite:///./data/app.db
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=false

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log
AI_LOG_AUTO_SUBMIT=true

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Admissions MVP ----
# extractive: local document lookup; llm: optional OpenAI synthesis
ANSWER_MODE=extractive
MODEL_NAME=gpt-4o-mini
# Staff access is provisioned by an administrator; there is no public staff registration.
STAFF_USERNAME=canbo
# Set a unique password (at least 12 characters before public deployment).
STAFF_PASSWORD=replace-with-a-private-password
# Optional Google staff login is allow-listed and is not shown on the staff login page.
# Add GOOGLE_REDIRECT_URI exactly to Google Console's Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/staff/google/callback
GOOGLE_STUDENT_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
# Require at least one allow-list. Separate multiple values with commas.
GOOGLE_ALLOWED_EMAILS=your.name@example.com
GOOGLE_ALLOWED_EMAIL_DOMAINS=example.com
# Student email/password accounts. Use a random secret of at least 32 chars.
AUTH_SECRET=
PUBLIC_BASE_URL=http://127.0.0.1:8000
STAFF_INVITE_HOURS=48
VERIFICATION_CODE_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
# Domain SMTP settings (587 + STARTTLS, or 465 + SSL).
SMTP_HOST=smtp.your-mail-provider.example
SMTP_PORT=587
SMTP_USER=no-reply@your-domain.example
SMTP_PASSWORD=
SMTP_FROM=no-reply@your-domain.example
SMTP_FROM_NAME=Trá»£ lÃ½ tuyá»ƒn sinh X
SMTP_SECURITY=starttls
SMTP_TIMEOUT=15
# Railway Hobby/Free plans may block outbound SMTP. Resend uses HTTPS instead.
RESEND_API_KEY=
RESEND_FROM=
MVP_DATA_DIR=data
SESSION_HOURS=24
SECURE_COOKIES=false
# Hard call limit; not a monetary spending limit. Failed calls count too.
LLM_DAILY_LIMIT=100
LLM_TIMEOUT=15
# Admin account seeded on startup (role admin, login at /admin). Set a unique >=12 char password outside demo.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@2026!
# Hours before a waiting ticket is listed as stale on the admin overview.
ADMIN_STALE_HOURS=24
