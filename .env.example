# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
# Legacy template only; MVP database is configured by MVP_DATA_DIR below.
DATABASE_URL=sqlite:///./data/app.db
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=false

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Admissions MVP ----
# extractive: local document lookup; llm: optional OpenAI synthesis
ANSWER_MODE=extractive
MODEL_NAME=gpt-4o-mini
STAFF_USERNAME=canbo
# Local demo only. Set a unique >=12 character password before public deployment.
STAFF_PASSWORD=Demo@2026!
MVP_DATA_DIR=data
SESSION_HOURS=24
SECURE_COOKIES=false
# Hard call limit; not a monetary spending limit. Failed calls count too.
LLM_DAILY_LIMIT=100
LLM_TIMEOUT=15
# Admin account seeded on startup (role admin, login at /admin). Set a unique >=12 char password outside demo.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@2026!
# Hours before a waiting ticket is listed as stale on the admin overview.
ADMIN_STALE_HOURS=24
