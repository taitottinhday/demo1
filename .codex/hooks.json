{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "name": "log-prompt",
            "type": "command",
            "command": "python scripts/log_hook.py --tool=codex",
            "commandWindows": ".\\.venv\\Scripts\\python.exe scripts\\log_hook.py --tool=codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "name": "log-tool-use",
            "type": "command",
            "command": "python scripts/log_hook.py --tool=codex",
            "commandWindows": ".\\.venv\\Scripts\\python.exe scripts\\log_hook.py --tool=codex",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "name": "log-stop",
            "type": "command",
            "command": "python scripts/log_hook.py --tool=codex",
            "commandWindows": ".\\.venv\\Scripts\\python.exe scripts\\log_hook.py --tool=codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "name": "log-session-end",
            "type": "command",
            "command": "python scripts/log_hook.py --tool=codex",
            "commandWindows": ".\\.venv\\Scripts\\python.exe scripts\\log_hook.py --tool=codex",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
